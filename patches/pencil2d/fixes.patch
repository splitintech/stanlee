diff --git a/util/download_verification.py b/util/download_verification.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bc714c00828fd5f73eb5b236abea84ddd8d04e9
--- /dev/null
+++ b/util/download_verification.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Create/check portable SHA-256 sidecars for final Pencil2D packages.
+
+Checksums detect changed bytes. Authenticate downloads separately with the
+GitHub build attestation (see docs/download-verification.md).
+"""
+# SPDX-License-Identifier: GPL-2.0-only
+import argparse
+import hashlib
+import re
+import sys
+from pathlib import Path
+
+
+def safe_name(name):
+    if not name or name in (".", "..") or any(c in name for c in "/\\\r\n\0"):
+        raise ValueError("Unsafe package filename")
+    return name
+
+
+def digest(path):
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"Not a regular package file: {path}")
+    result = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            result.update(block)
+    return result.hexdigest()
+
+
+def create(path):
+    name = safe_name(path.name)
+    checksum = digest(path)
+    sidecar = path.with_name(name + ".sha256")
+    if sidecar.is_symlink():
+        raise ValueError(f"Refusing to overwrite a symbolic link: {sidecar}")
+    # Binary mode prevents Windows newline translation. Compatible with sha256sum.
+    sidecar.write_bytes(f"{checksum} *{name}\n".encode("utf-8"))
+    return sidecar
+
+
+def verify(sidecar):
+    if sidecar.is_symlink():
+        raise ValueError(f"Not a regular checksum file: {sidecar}")
+    with sidecar.open("rb") as stream:
+        data = stream.read(4097)
+    if len(data) > 4096:
+        raise ValueError("Checksum file is too large")
+    match = re.fullmatch(r"([0-9a-f]{64}) [ *]([^\r\n]+)\n?", data.decode("utf-8"))
+    if not match:
+        raise ValueError("Expected exactly one SHA-256 checksum record")
+    checksum, name = match.groups()
+    name = safe_name(name)
+    if sidecar.name != name + ".sha256":
+        raise ValueError("Checksum filename does not match the package filename")
+    package = sidecar.with_name(name)
+    if digest(package) != checksum:
+        raise ValueError(f"SHA-256 mismatch: {package}")
+    return package
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("command", choices=("create", "verify"))
+    parser.add_argument("files", nargs="+", type=Path)
+    args = parser.parse_args(argv)
+    try:
+        for path in args.files:
+            if args.command == "create":
+                print(create(path))
+            else:
+                print(f"OK: {verify(path)}")
+    except (OSError, ValueError, UnicodeError) as error:
+        print(f"Verification failed: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/util/tests/test_download_verification.py b/util/tests/test_download_verification.py
new file mode 100644
index 0000000000000000000000000000000000000000..71fdb5ff137f9908b918029ab0caafa3046cf50d
--- /dev/null
+++ b/util/tests/test_download_verification.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: GPL-2.0-only
+import importlib.util
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[1] / "download_verification.py"
+spec = importlib.util.spec_from_file_location("download_verification", SCRIPT)
+verification = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(verification)
+
+
+class DownloadVerificationTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.package = self.root / "pencil2d mac é.zip"
+        self.package.write_bytes(b"final signed package\0\xff")
+        self.sidecar = verification.create(self.package)
+
+    def test_round_trip_and_deterministic_standard_format(self):
+        self.assertEqual(verification.verify(self.sidecar), self.package)
+        original = self.sidecar.read_bytes()
+        verification.create(self.package)
+        self.assertEqual(self.sidecar.read_bytes(), original)
+        self.assertRegex(original, rb"^[0-9a-f]{64} \*pencil2d mac .*\.zip\n$")
+        self.assertNotIn(b"\r", original)
+
+    def test_tampered_package_and_checksum_fail(self):
+        original = self.package.read_bytes()
+        self.package.write_bytes(original + b"tampered")
+        with self.assertRaisesRegex(ValueError, "mismatch"):
+            verification.verify(self.sidecar)
+        self.package.write_bytes(original)
+        self.sidecar.write_bytes(b"0" * 64 + b" *" + self.package.name.encode() + b"\n")
+        with self.assertRaisesRegex(ValueError, "mismatch"):
+            verification.verify(self.sidecar)
+
+    def test_missing_file_fails(self):
+        self.package.unlink()
+        with self.assertRaises(ValueError):
+            verification.verify(self.sidecar)
+
+    def test_multiple_records_and_bad_encodings_fail(self):
+        record = self.sidecar.read_bytes()
+        for data in (record + record, b"invalid", b"\xff", b"x" * 4097):
+            with self.subTest(data=data[:30]):
+                self.sidecar.write_bytes(data)
+                with self.assertRaises((ValueError, UnicodeError)):
+                    verification.verify(self.sidecar)
+
+    def test_paths_and_ambiguous_filenames_are_rejected(self):
+        for name in ("../outside", "/outside", "C:\\outside", ".", "..", "a\nb", "a\rb", "a\0b"):
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    verification.safe_name(name)
+        original = self.sidecar.read_bytes()
+        renamed = self.root / "different.sha256"
+        renamed.write_bytes(original)
+        with self.assertRaisesRegex(ValueError, "filename"):
+            verification.verify(renamed)
+
+    def test_symlinks_are_rejected(self):
+        link = self.root / "link.zip"
+        try:
+            link.symlink_to(self.package)
+        except OSError:
+            self.skipTest("Creating symlinks is unavailable")
+        with self.assertRaises(ValueError):
+            verification.create(link)
+        self.sidecar.unlink()
+        self.sidecar.symlink_to(self.package)
+        with self.assertRaises(ValueError):
+            verification.create(self.package)
+
+    def test_empty_package_can_be_verified(self):
+        self.package.write_bytes(b"")
+        verification.create(self.package)
+        self.assertEqual(verification.verify(self.sidecar), self.package)
+
+    def test_cli_nonzero_on_tampering_and_missing_inputs(self):
+        result = subprocess.run([sys.executable, str(SCRIPT), "verify", str(self.sidecar)], capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.package.write_bytes(b"corrupt")
+        result = subprocess.run([sys.executable, str(SCRIPT), "verify", str(self.sidecar)], capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+        result = subprocess.run([sys.executable, str(SCRIPT), "verify"], capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
