diff --git a/docs/download-verification.md b/docs/download-verification.md
new file mode 100644
index 0000000000000000000000000000000000000000..0ac50cbede97890e904ca6cfbf622b5992abe19a
--- /dev/null
+++ b/docs/download-verification.md
@@ -0,0 +1,102 @@
+# Verify a Pencil2D download
+
+CI builds containing this change publish a `<package>.sha256` file alongside
+each final application package. Successful builds from `master`, `release/*`,
+and tags also publish GitHub build attestations and a portable
+`pencil2d-provenance.sigstore.json` bundle. Pull request and ordinary feature
+branch builds have checksums only.
+
+Older downloads do not gain attestations retroactively. If no attestation is
+available, verification has not succeeded. Choose a build that publishes one,
+or use an independently authenticated installation method.
+
+## Check the downloaded bytes
+
+Download the package and its matching `.sha256` from the same completed
+GitHub Actions run. Keep both files in the same directory with their original
+filenames. The package checksum covers the final archive, installer, DMG, or
+AppImage after CI signing and notarization, wherever those are configured.
+
+Using Python 3 and this repository's verification utility:
+
+```sh
+python3 util/download_verification.py verify /path/to/package.AppImage.sha256
+```
+
+On Windows, use `python` instead of `python3`. The utility returns a nonzero
+exit code for a changed or missing file and rejects malformed checksum files.
+
+Alternatively, in the download directory:
+
+```sh
+# Linux
+sha256sum --check package.AppImage.sha256
+# macOS
+shasum -a 256 --check package.zip.sha256
+```
+
+PowerShell users can compare `(Get-FileHash .\package.zip -Algorithm SHA256).Hash`
+with the first 64 characters of `package.zip.sha256`.
+
+A checksum alone detects changed bytes relative to that checksum file. It
+does not authenticate the publisher: an attacker could replace both files.
+
+## Authenticate the build
+
+Install a current [GitHub CLI](https://cli.github.com/) and verify the actual
+package, using the repository and workflow identity you expect. For an official
+tagged release, replace `vX.Y.Z` and the package path:
+
+```sh
+gh attestation verify ./package.AppImage \
+  --repo pencil2d/pencil \
+  --signer-workflow pencil2d/pencil/.github/workflows/ci.yml \
+  --source-ref refs/tags/vX.Y.Z \
+  --deny-self-hosted-runners
+```
+
+For an official nightly, use `--source-ref refs/heads/master` and also pass
+`--source-digest FULL_COMMIT_SHA` for the expected commit from that build's
+GitHub run. Binding the expected commit prevents accepting a different valid
+build. Use a published `refs/heads/release/...` ref when verifying a release
+branch build.
+
+For a third-party fork, use that fork's repository and signer-workflow identity,
+together with its expected ref and commit. A fork attestation identifies the
+fork; it does not establish endorsement by Pencil2D.
+
+For verification using a downloaded bundle, add:
+
+```sh
+--bundle ./pencil2d-provenance.sigstore.json
+```
+
+Keep the repository, workflow, ref, and commit checks when using a bundle.
+Online verification also checks the current repository identity; bundle-only
+verification cannot detect later repository/owner renames or name reuse.
+Fully offline use additionally needs a trusted root prepared according to the
+[GitHub CLI verification documentation](https://cli.github.com/manual/gh_attestation_verify).
+
+Attestations authenticate the bytes and their GitHub Actions origin. They do
+not establish that the source or dependencies are defect-free, or that builds
+are reproducible. Existing platform code signing and notarization remain
+additional checks.
+
+## Publishing releases
+
+Copy the exact final packages, matching `.sha256` files, and provenance bundle
+from the same successful trusted CI run to the GitHub release/download page.
+Do not rebuild, recompress, or sign those packages after hashing/attestation.
+If a package changes, publish a new checksum and a new authenticated build;
+the old attestation cannot authenticate changed bytes.
+
+The workflow does not create releases or modify the separate download service.
+Maintainers publishing through those surfaces must expose the verification
+files as well. Manual signing of Windows releases after CI changes the bytes
+and requires a fresh checksum; CI provenance for the earlier unsigned package
+does not verify that manually modified package.
+
+The provenance job receives OIDC and attestation permissions only for trusted
+push/manual runs on the listed refs. Build and pull request jobs retain
+read-only permissions. See GitHub's
+[artifact attestation guide](https://docs.github.com/en/actions/how-tos/secure-your-work/use-artifact-attestations/use-artifact-attestations).
diff --git a/tests/src/test_hiddenlayerediting.cpp b/tests/src/test_hiddenlayerediting.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..22e03d5a2fdc6943881329d315d6ce376caa36e8
--- /dev/null
+++ b/tests/src/test_hiddenlayerediting.cpp
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "catch.hpp"
+
+#include <QApplication>
+#include <QClipboard>
+#include <QKeyEvent>
+#include <QSettings>
+#include <QTemporaryDir>
+#include "bitmapimage.h"
+#include "clipboardmanager.h"
+#include "editor.h"
+#include "layerbitmap.h"
+#include "object.h"
+#include "scribblearea.h"
+#include "selectionmanager.h"
+#include "undoredomanager.h"
+
+namespace {
+struct HiddenLayerSettings
+{
+    QTemporaryDir directory;
+    QSettings::Format previous = QSettings::defaultFormat();
+    HiddenLayerSettings()
+    {
+        QSettings::setDefaultFormat(QSettings::IniFormat);
+        QSettings::setPath(QSettings::IniFormat, QSettings::UserScope, directory.path());
+    }
+    ~HiddenLayerSettings() { QSettings::setDefaultFormat(previous); }
+};
+
+class HiddenLayerCanvas : public ScribbleArea
+{
+public:
+    HiddenLayerCanvas() : ScribbleArea(nullptr) {}
+    void showLayerNotVisibleWarning() override { ++warnings; }
+    int warnings = 0;
+};
+
+struct HiddenLayerFixture
+{
+    HiddenLayerSettings settings;
+    Editor editor;
+    HiddenLayerCanvas canvas;
+    LayerBitmap* layer;
+
+    HiddenLayerFixture()
+    {
+        editor.setScribbleArea(&canvas);
+        editor.init();
+        Object* object = new Object;
+        object->init();
+        layer = object->addNewBitmapLayer();
+        layer->addNewKeyFrameAt(2);
+        BitmapImage image(QRect(10, 10, 20, 20), Qt::red);
+        layer->getBitmapImageAtFrame(1)->paste(&image);
+        editor.setObject(object);
+        canvas.setEditor(&editor);
+        canvas.init();
+        editor.select()->setSelection(image.bounds());
+        editor.clipboards()->copyBitmapImage(&image, image.bounds());
+    }
+
+    template<typename Action> void expectWarning(Action action)
+    {
+        int previousWarnings = canvas.warnings;
+        action();
+        REQUIRE(canvas.warnings == previousWarnings + 1);
+    }
+};
+}
+
+TEST_CASE("Hidden layers reject canvas and clipboard edits before side effects", "[1942]")
+{
+    HiddenLayerFixture fixture;
+    fixture.layer->setVisible(false); // Also exercise a stale selection from before hiding.
+    BitmapImage before = *fixture.layer->getBitmapImageAtFrame(1);
+    auto selection = fixture.editor.select()->selectionTransform();
+    auto bounds = fixture.editor.select()->mySelectionRect();
+    QApplication::clipboard()->setText("clipboard sentinel");
+    bool modified = false;
+    QObject::connect(&fixture.editor, &Editor::frameModified, [&] { modified = true; });
+
+    SECTION("clear") { fixture.expectWarning([&] { fixture.editor.clearCurrentFrame(); }); }
+    SECTION("select all") { fixture.expectWarning([&] { fixture.editor.selectAll(); }); }
+    SECTION("delete selection") { fixture.expectWarning([&] { fixture.canvas.deleteSelection(); }); }
+    SECTION("cut selection") { fixture.expectWarning([&] { fixture.editor.copyAndCut(); }); }
+    SECTION("flip horizontally") { fixture.expectWarning([&] { fixture.editor.flipSelection(false); }); }
+    SECTION("flip vertically") { fixture.expectWarning([&] { fixture.editor.flipSelection(true); }); }
+    SECTION("paste") { fixture.expectWarning([&] { fixture.editor.paste(); }); }
+    SECTION("paste previous") { fixture.expectWarning([&] { fixture.editor.pasteFromPreviousFrame(); }); }
+    SECTION("apply transform") { fixture.expectWarning([&] { fixture.canvas.applyTransformedSelection(); }); }
+    SECTION("arrow key")
+    {
+        QKeyEvent event(QEvent::KeyPress, Qt::Key_Right, Qt::NoModifier);
+        fixture.expectWarning([&] { fixture.canvas.keyEventForSelection(&event); });
+    }
+    SECTION("remove frame") { fixture.expectWarning([&] { fixture.editor.removeKey(); }); }
+    SECTION("add frame") { fixture.expectWarning([&] { REQUIRE(fixture.editor.addNewKey() == nullptr); }); }
+
+    REQUIRE(*fixture.layer->getBitmapImageAtFrame(1)->image() == *before.image());
+    REQUIRE(fixture.layer->getBitmapImageAtFrame(1)->bounds() == before.bounds());
+    REQUIRE(fixture.editor.select()->selectionTransform() == selection);
+    REQUIRE(fixture.editor.select()->mySelectionRect() == bounds);
+    REQUIRE(QApplication::clipboard()->text() == "clipboard sentinel");
+    REQUIRE_FALSE(modified);
+    REQUIRE_FALSE(fixture.editor.undoRedo()->hasUnsavedChanges());
+}
+
+TEST_CASE("Cutting hidden selected frames does not change the clipboard or timeline", "[1942]")
+{
+    HiddenLayerFixture fixture;
+    fixture.editor.deselectAll();
+    fixture.layer->setFrameSelected(1, true);
+    fixture.layer->setFrameSelected(2, true);
+    fixture.layer->setVisible(false);
+    QApplication::clipboard()->setText("frame clipboard sentinel");
+    fixture.expectWarning([&] { fixture.editor.copyAndCut(); });
+    REQUIRE(fixture.layer->keyExists(1));
+    REQUIRE(fixture.layer->keyExists(2));
+    REQUIRE(QApplication::clipboard()->text() == "frame clipboard sentinel");
+}
+
+TEST_CASE("Hiding clears only the affected layer's selection", "[1942]")
+{
+    HiddenLayerFixture fixture;
+    auto other = fixture.editor.object()->addNewBitmapLayer();
+    other->setFrameSelected(1, true);
+    fixture.editor.switchVisibilityOfLayer(1);
+    REQUIRE_FALSE(other->visible());
+    REQUIRE_FALSE(other->hasAnySelectedFrames());
+    REQUIRE(fixture.editor.select()->somethingSelected());
+
+    fixture.editor.switchVisibilityOfLayer(0);
+    REQUIRE_FALSE(fixture.layer->visible());
+    REQUIRE_FALSE(fixture.editor.select()->somethingSelected());
+    fixture.editor.switchVisibilityOfLayer(0);
+    REQUIRE(fixture.layer->visible());
+    fixture.editor.selectAll();
+    REQUIRE(fixture.editor.select()->somethingSelected());
+    fixture.editor.clearCurrentFrame();
+    REQUIRE(fixture.layer->getBitmapImageAtFrame(1)->bounds().isEmpty());
+}
+
+TEST_CASE("Hidden-layer data model remains available to undo and loading", "[1942]")
+{
+    HiddenLayerFixture fixture;
+    fixture.layer->setVisible(false);
+    REQUIRE_FALSE(fixture.editor.canEditLayer(fixture.layer, false));
+    REQUIRE(fixture.layer->moveKeyFrame(2, 1));
+    REQUIRE(fixture.layer->keyExists(3));
+    fixture.editor.scrubTo(3);
+    REQUIRE(fixture.editor.currentFrame() == 3);
+    fixture.layer->setVisible(true);
+    REQUIRE(fixture.editor.canEditLayer(fixture.layer, false));
+}
